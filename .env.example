# Backend runtime configuration
PORT=8080
NODE_ENV=production

# Public origin for the hosted browser controller. Must be HTTPS.
PUBLIC_BASE_URL=https://remote.example.com

# Required for authenticated sessions; generate a random secret of at least 32 bytes.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

# ICE configuration. Use your deployed STUN/TURN infrastructure.
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=turn:turn.example.com:3478
TURN_SHARED_SECRET=REPLACE_WITH_COTURN_STATIC_AUTH_SECRET

# Android Gradle build can read this value to bootstrap runtime configuration.
# Do not put JWT_SECRET or TURN_SHARED_SECRET in the Android project.
