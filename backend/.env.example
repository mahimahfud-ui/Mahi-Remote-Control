# Copy to backend/.env and replace every placeholder before deployment.
PORT=8080
NODE_ENV=production

# Public HTTPS origin hosting both /connect and /ws.
PUBLIC_BASE_URL=https://remote.example.com

# Generate a new random value; minimum 32 bytes. Never package in Android.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

# Coturn REST API configuration. The same secret must be configured on Coturn.
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=turn:turn.example.com:3478
TURN_REALM=turn.example.com
TURN_SHARED_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_COTURN_SECRET

# Database configuration is currently a deployment placeholder; the current
# DeviceService session/code stores are process-local in-memory Maps.
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgres://mahi_admin:${POSTGRES_PASSWORD}@postgres-db:5432/mahi_remote
