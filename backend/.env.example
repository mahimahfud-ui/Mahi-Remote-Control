# Backend runtime variables. Keep this file private; never place these secrets in Android or browser code.
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Actual public HTTPS origin for the browser, REST API and WSS signaling.
PUBLIC_BASE_URL=https://remote.example.com
TRUST_PROXY=true

# Use independent cryptographically random secrets of at least 32 bytes.
JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET_AT_LEAST_32_BYTES
PAIRING_CODE_PEPPER=REPLACE_WITH_DIFFERENT_RANDOM_PAIRING_PEPPER_AT_LEAST_32_BYTES
TURN_SHARED_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_TURN_SECRET_AT_LEAST_32_BYTES

# Private PostgreSQL connection (do not expose PostgreSQL publicly).
DATABASE_URL=postgres://mahi_admin:CHANGE_ME@127.0.0.1:5432/mahi_remote
DATABASE_SSL=false
PG_POOL_MAX=10

# Public STUN/TURN endpoints; the private shared secret stays on this server and Coturn only.
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=turn:turn.example.com:3478
TURN_REALM=turn.example.com

# Stable unique name for this backend process/replica.
INSTANCE_ID=mahi-remote-1
