# Copy this file to .env in this directory. Generate new random secrets; never commit .env.
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
PUBLIC_BASE_URL=https://remote.your-domain.example
ALLOWED_ORIGINS=https://remote.your-domain.example
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
