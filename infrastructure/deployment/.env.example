# Copy this file to .env in this directory. Generate new random secrets; never commit .env.
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
PUBLIC_BASE_URL=https://remote.your-domain.example
ALLOWED_ORIGINS=https://remote.your-domain.example
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
TURN_URL=turn:turn.your-domain.example:3478
TURN_REALM=turn.your-domain.example
TURN_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
STUN_URL=stun:stun.l.google.com:19302

# Alternative: Cloudflare Realtime managed TURN.
# Create a TURN key and a narrowly-scoped API token in Cloudflare, then store these
# server-only values here or in your hosting provider's secret manager.
# Do not put these values in the Android app, browser code, or Git.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
