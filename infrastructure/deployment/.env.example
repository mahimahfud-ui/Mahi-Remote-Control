# Copy to the repository root as .env and replace every placeholder.
# DNS A/AAAA records for DOMAIN must point to this server's public IP.

DOMAIN=remote.example.com
PUBLIC_BASE_URL=https://remote.example.com
ACME_EMAIL=owner@example.com

# Generate independent random values for all three secrets (at least 32 bytes).
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET_AT_LEAST_32_BYTES
PAIRING_CODE_PEPPER=REPLACE_WITH_DIFFERENT_RANDOM_PAIRING_PEPPER_AT_LEAST_32_BYTES
TURN_SHARED_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_TURN_SECRET_AT_LEAST_32_BYTES

# Public Coturn endpoint; TURN_REALM must match the server's configured realm.
TURN_SERVER_URL=turn:turn.example.com:3478
TURN_REALM=turn.example.com
STUN_SERVER_URL=stun:stun.l.google.com:19302

# Optional tuning. Each backend process generates a unique instance ID when INSTANCE_ID is empty.
PG_POOL_MAX=10
